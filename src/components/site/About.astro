---
import Icon from "./Icon.astro";
import { getContent } from "../../config/content";

const { aboutContent, ui } = getContent(Astro.currentLocale);
const { aboutMe, education, image } = aboutContent;
---

<section class="section alt" id="about">
  <div class="container">
    <span class="section-eyebrow reveal">{ui.about.eyebrow}</span>
    <h2 class="section-title reveal">{aboutContent.title}</h2>

    <div class="about-grid" style="margin-top:2rem">
      <div class="portrait reveal">
        <img src={image.src} alt={image.alt} loading="lazy" />
      </div>
      <div class="about-text reveal" style="--d:120ms">
        <h3 class="subheading">{aboutMe.title}</h3>
        <p>{aboutMe.description}</p>
      </div>
    </div>

    <h3 class="subheading reveal">{education.title}</h3>
    <div class="timeline-grid">
      {education.items.map((e, i) => (
        <article class="card hover edu-card reveal" style={`--d:${i * 100}ms`}>
          <span class="period">{e.period}</span>
          <h3>{e.degree}</h3>
          <span class="inst">{e.institution}</span>
          <p>{e.description}</p>
          {e.link && (
            <a class="text-link" href={e.link} target="_blank" rel="noopener">
              {ui.about.visit} <Icon name="arrow-up-right" />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
