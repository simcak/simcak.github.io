---
import Icon from "./Icon.astro";
import { getContent } from "../../config/content";

const { siteConfig, homeContent, ui } = getContent(Astro.currentLocale);
const t = ui.contact;
---

<section class="section" id="contact">
  <div class="container">
    <div class="card contact-card reveal">
      <span class="section-eyebrow">{t.eyebrow}</span>
      <h2>{t.title} <span class="gradient-text">{t.titleHighlight}</span></h2>
      <p>{t.text}</p>
      <div class="contact-actions">
        <a class="btn btn-primary" href={siteConfig.social.email}><Icon name="mail" /> {t.email}</a>
        <a class="btn btn-outline" href={siteConfig.social.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
        <a class="btn btn-outline" href={siteConfig.social.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
        <a class="btn btn-outline" href={homeContent.buttons.cv.href} target="_blank" rel="noopener"><Icon name="download" /> {homeContent.buttons.cv.text}</a>
      </div>
    </div>
  </div>
</section>
