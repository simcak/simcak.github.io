---
import Icon from "./Icon.astro";
import { siteConfig, homeContent } from "../../config/content";
---

<section class="section" id="contact">
  <div class="container">
    <div class="card contact-card reveal">
      <span class="section-eyebrow">06 / contact</span>
      <h2>Let's build something <span class="gradient-text">together</span></h2>
      <p>Have a project, an idea, or just want to say hi? My inbox is always open.</p>
      <div class="contact-actions">
        <a class="btn btn-primary" href={siteConfig.social.email}><Icon name="mail" /> Email me</a>
        <a class="btn btn-outline" href={siteConfig.social.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
        <a class="btn btn-outline" href={siteConfig.social.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
        <a class="btn btn-outline" href={homeContent.buttons.cv.href} target="_blank" rel="noopener"><Icon name="download" /> {homeContent.buttons.cv.text}</a>
      </div>
    </div>
  </div>
</section>
