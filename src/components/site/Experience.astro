---
import Icon from "./Icon.astro";
import { getContent } from "../../config/content";

const { aboutContent, ui } = getContent(Astro.currentLocale);
const { experience } = aboutContent;
const icons: Record<string, string> = { movie: "🎬", theatre: "🎭" };
---

<section class="section alt" id="experience">
  <div class="container">
    <span class="section-eyebrow reveal">{ui.experience.eyebrow}</span>
    <h2 class="section-title reveal">{experience.title}</h2>
    <p class="section-lead reveal">{ui.experience.lead}</p>

    <div class="timeline">
      {experience.items.map((item: any, i: number) => (
        <article class="card exp-item reveal" style={`--d:${i * 100}ms`}>
          <span class="exp-icon" aria-hidden="true">{icons[item.icon] ?? "💼"}</span>
          <span class="exp-period">{item.period}</span>
          <h3>{item.position}</h3>
          <div class="exp-company">{item.company}</div>
          <p>{item.description}</p>
          {item.link && (
            <a class="text-link" href={item.link} target="_blank" rel="noopener" style="margin-top:0.75rem">
              {ui.experience.learnMore} <Icon name="arrow-up-right" />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
