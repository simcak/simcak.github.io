---
import "../styles/global.css";
import { getContent } from "../config/content";
import { locales, toLang, langPath } from "../config/i18n";

interface Props {
  title?: string;
  description?: string;
}
const lang = toLang(Astro.currentLocale);
const { siteConfig } = getContent(lang);
const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "cs" ? "cs_CZ" : "en_US"} />
    <meta name="theme-color" content="#0ea5e9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(langPath(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(langPath("en"), Astro.site)} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Set theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <slot />

    <script>
      // Scroll-reveal
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
